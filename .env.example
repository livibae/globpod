# Anthropic Claude API — for podcast script generation
ANTHROPIC_API_KEY=sk-ant-api03-...

# ElevenLabs — for text-to-speech MP3 generation
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=your_voice_id

# Cloudflare R2 — S3-compatible storage for MP3s and RSS feed
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET_NAME=globpod
CF_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CF_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Private feed URL token — keeps your feed URL secret (generate with: openssl rand -hex 16)
FEED_SECRET_TOKEN=

# Resend — for error email notifications
RESEND_API_KEY=re_...
NOTIFY_EMAIL=you@example.com

# Optional: skip episode generation when fewer than this many new articles
# MIN_ARTICLES_FOR_EPISODE=5
