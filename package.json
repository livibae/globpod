{
  "name": "globpod",
  "version": "0.1.0",
  "description": "Personal AI-powered morning news podcast generator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/scheduler.js",
    "run-once": "node --env-file=.env dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "edge-tts-universal": "^1.4.0",
    "fast-xml-parser": "^5.4.2",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^10.5.0",
    "node-cron": "^3.0.3",
    "resend": "^4.0.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
